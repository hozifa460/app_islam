  "_comment_sharia_warnings": "═══ التنبيهات الشرعية ═══",
  "shariaWarningsTitle": "تنبيهات شرعية مهمة",
  "shariaWarningsCount": "10 تنبيهات يجب معرفتها",

  "warning1Title": "سداد الديون والوصايا أولاً",
  "warning1Content": "التركة لا تُوزع إلا بعد:\n• تجهيز الميت (الغسل والتكفين والدفن)\n• سداد جميع الديون\n• تنفيذ الوصايا (في حدود الثلث لغير وارث)\n\n﴿مِن بَعْدِ وَصِيَّةٍ يُوصِي بِهَا أَوْ دَيْنٍ﴾ [النساء: 11]",

  "warning2Title": "القاتل لا يرث",
  "warning2Content": "قال ﷺ: «لَيْسَ لِلْقَاتِلِ مِيرَاثٌ» [رواه النسائي]\nسواء كان القتل عمداً أو خطأً عند الجمهور.",

  "warning3Title": "اختلاف الدين مانع",
  "warning3Content": "قال ﷺ: «لَا يَرِثُ الْمُسْلِمُ الْكَافِرَ، وَلَا يَرِثُ الْكَافِرُ الْمُسْلِمَ» [متفق عليه]",

  "warning4Title": "الرق مانع من الإرث",
  "warning4Content": "الرقيق لا يرث ولا يُورث (إجماع)\nوقد زال هذا المانع في عصرنا بحمد الله.",

  "warning5Title": "ميراث الحمل",
  "warning5Content": "• يُوقف للحمل أكبر النصيبين\n• لا تُقسم التركة نهائياً حتى يُولد\n• يشترط أن يُولد حياً ليرث\n\nقال ﷺ: «إِذَا اسْتَهَلَّ الصَّبِيُّ وُرِّثَ» [رواه أبو داود]",

  "warning6Title": "ميراث المفقود",
  "warning6Content": "• يُعتبر حياً بالنسبة لماله\n• يُوقف نصيبه من تركة غيره\n• يحكم القاضي بوفاته بعد مدة معينة",

  "warning7Title": "الخنثى المشكل",
  "warning7Content": "• يُعطى أقل النصيبين احتياطاً\n• أو يُوقف الفرق حتى يتبين حاله\n• في عصرنا يمكن تحديد الجنس بالفحوصات",

  "warning8Title": "لا وصية لوارث",
  "warning8Content": "قال ﷺ: «إِنَّ اللَّهَ قَدْ أَعْطَى كُلَّ ذِي حَقٍّ حَقَّهُ، فَلَا وَصِيَّةَ لِوَارِثٍ» [رواه أبو داود والترمذي]\n\nإلا بإذن بقية الورثة. والوصية لغير الوارث في حدود الثلث.",

  "warning9Title": "تحريم تغيير الفرائض",
  "warning9Content": "﴿تِلْكَ حُدُودُ اللَّهِ ۚ وَمَن يُطِعِ اللَّهَ وَرَسُولَهُ يُدْخِلْهُ جَنَّاتٍ﴾\n﴿وَمَن يَعْصِ اللَّهَ وَرَسُولَهُ وَيَتَعَدَّ حُدُودَهُ يُدْخِلْهُ نَارًا﴾ [النساء: 13-14]",

  "warning10Title": "وجوب مراجعة عالم متخصص",
  "warning10Content": "• هذا البرنامج للاستئناس والتعلم فقط\n• لا يُغني عن مراجعة عالم شرعي متخصص\n• يُنصح بعرض كل حالة على المحكمة الشرعية\n\n﴿فَاسْأَلُوا أَهْلَ الذِّكْرِ إِن كُنتُمْ لَا تَعْلَمُونَ﴾ [النحل: 43]",

